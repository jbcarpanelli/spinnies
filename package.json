{
  "name": "spinnies",
  "version": "0.6.0",
  "description": "Create and manage multiple spinners in command-line interface programs",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=26"
  },
  "types": "index.d.ts",
  "scripts": {
    "demo": "node examples/demo.js",
    "demo-stop-all": "node examples/demo-stop-all.js",
    "demo-destroy": "node examples/demo-destroy.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pretest": "npm run lint",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\""
  },
  "keywords": [
    "node",
    "spinner",
    "cli",
    "console",
    "command-line",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/3z3qu13l/spinnies.git"
  },
  "bugs": {
    "url": "https://github.com/3z3qu13l/spinnies/issues"
  },
  "homepage": "https://github.com/3z3qu13l/spinnies#readme",
  "license": "MIT",
  "dependencies": {
    "cli-cursor": "5.0.0",
    "string-width": "8.2.2",
    "strip-ansi": "7.2.0",
    "yoctocolors": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0"
  }
}
